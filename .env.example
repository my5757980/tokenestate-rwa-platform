# ── Hardhat / Contracts ──────────────────────────────────────────────────────
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
SEPOLIA_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY_HERE
REPORT_GAS=false

# ── Demo walkthrough signer (sign_server.cjs) ─────────────────────────────────
# A THROWAWAY testnet key only: while it runs, the server signs any message for any page.
DEMO_SIGNER_PRIVATE_KEY=

# ── Frontend — Contract Addresses (fill after deploy) ─────────────────────────
NEXT_PUBLIC_PROPERTY_REGISTRY_ADDRESS=
NEXT_PUBLIC_RENT_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_KYC_BADGE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# ── Frontend — Services ───────────────────────────────────────────────────────
NEXT_PUBLIC_ALCHEMY_ID=YOUR_ALCHEMY_ID_HERE
# Sepolia RPC the site reads through (else the rate-limited public one), e.g. an Alchemy URL
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WC_PROJECT_ID_HERE
NEXT_PUBLIC_GRAPH_URL=https://api.studio.thegraph.com/query/YOUR_ID/tokenestate/version/latest
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── IPFS / Pinata (server-side only: used by the /api/ipfs route) ────────────
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY

# ── Chain ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111
